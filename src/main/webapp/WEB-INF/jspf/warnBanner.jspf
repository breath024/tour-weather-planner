<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%-- 기상특보 배너: 고른 시·도에 발효 중인 특보(눈에 띄게)와 예비특보(작게). 아무것도 없으면 아무것도 안 나온다.
     발효 중인 특보가 있을 때만 role="alert"(읽어 주기), 예비특보 · 다른 지역 소식만 있으면 차분한 role="status".
     모레부터(${warnFar})는 「지금 발효 중인 특보」일 뿐 고른 날 특보는 아직 모르므로 빨간 경고 대신 차분한 안내로 보인다(점수 칩과 같은 말).
     쓰는 쪽에서 ${warnCurrent} · ${warnPrelim} · ${warnElsewhere} · ${warnIssued} · ${warnFar} 를 정해 둔다 --%>
<c:if test="${not empty warnCurrent or not empty warnPrelim or warnElsewhere > 0}">
	<c:set var="alertNow" value="${not empty warnCurrent and not warnFar}"/>
	<section class="warnbar ${alertNow ? 'now' : (not empty warnCurrent or not empty warnPrelim ? 'pre' : 'soft')}" role="${alertNow ? 'alert' : 'status'}" aria-label="기상특보">
		<svg class="ic warn-ic" aria-hidden="true"><use href="${alertNow ? '#i-warn' : '#i-info'}"/></svg>
		<div class="warn-body">
			<c:if test="${not empty warnCurrent and not warnFar}">
				<p class="warn-now"><b>기상특보가 발효 중이에요</b></p>
				<ul class="warn-list">
					<c:forEach items="${warnCurrent}" var="w"><li class="warn-item ${w.major ? 'major' : ''}"><c:out value="${w.text}"/></li></c:forEach>
				</ul>
			</c:if>
			<c:if test="${not empty warnCurrent and warnFar}">
				<p class="warn-pre"><b>지금 발효 중인 특보예요</b></p>
				<ul class="warn-list">
					<c:forEach items="${warnCurrent}" var="w"><li class="warn-item"><c:out value="${w.text}"/></li></c:forEach>
				</ul>
			</c:if>
			<c:if test="${not empty warnPrelim}">
				<p class="warn-pre"><b>예비특보</b> 곧 특보가 나올 수 있어요.</p>
				<ul class="warn-list">
					<c:forEach items="${warnPrelim}" var="w"><li class="warn-item"><c:out value="${w.text}"/><c:if test="${not empty w.when}"> · <c:out value="${w.when}"/></c:if></li></c:forEach>
				</ul>
			</c:if>
			<c:if test="${empty warnCurrent and empty warnPrelim and warnElsewhere > 0}">
				<p class="warn-pre">같은 시·도의 다른 지역에 특보가 ${warnElsewhere}건 있어요. 고른 시·군·구에는 해당하지 않아요.</p>
			</c:if>
			<c:if test="${not empty warnCurrent or not empty warnPrelim}">
				<details class="warn-more">
					<summary>자세히</summary>
					<c:if test="${not empty warnCurrent and not warnFar}"><p class="warn-tip">야외 일정은 미리 다른 날로 옮기거나 실내로 바꾸는 걸 권해요.</p></c:if>
					<c:if test="${not empty warnCurrent and warnFar}"><p class="warn-tip">고른 날에도 이어질지는 아직 알 수 없어요.</p></c:if>
					<c:if test="${warnElsewhere > 0}"><p class="warn-tip">같은 시·도의 다른 지역에는 특보가 ${warnElsewhere}건 더 있어요. 고른 시·군·구에는 해당하지 않아요.</p></c:if>
					<c:if test="${not empty warnIssued}"><p class="warn-src">기상청 ${fn:escapeXml(warnIssued)} 발표</p></c:if>
				</details>
			</c:if>
			<c:if test="${empty warnCurrent and empty warnPrelim and not empty warnIssued}"><p class="warn-src">기상청 ${fn:escapeXml(warnIssued)} 발표</p></c:if>
		</div>
	</section>
</c:if>
