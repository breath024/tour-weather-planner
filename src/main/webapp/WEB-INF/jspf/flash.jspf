<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%-- 담기 · 빼기를 처리한 결과 문구(한 번만 나옴) --%>
<c:if test="${not empty flashMsg}">
	<div class="alert ${flashOk ? 'ok' : ''}" role="status"><svg class="ic" aria-hidden="true"><use href="${flashOk ? '#i-check' : '#i-info'}"/></svg><span><c:out value="${flashMsg}"/></span></div>
</c:if>
