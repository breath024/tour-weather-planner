<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%-- CSS · JS 뒤 ?v= 는 AssetVersionListener 가 배포 때마다 바꾸는 번호(옛 캐시로 화면 깨짐 방지) --%>
<%-- 모든 화면 공통 머리: 쓰는 쪽에서 pageTitle · navActive(plan|explore|course) · needMap(지도 화면) · pageJs(선택)를 정해 둔다 --%>
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0e1014" media="(prefers-color-scheme: dark)">
<title>${fn:escapeXml(pageTitle)} · 여행 날씨</title>
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css">
<c:if test="${needMap}"><link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"></c:if>
<link rel="stylesheet" href="css/style.css?v=${applicationScope.assetV}">
<%-- 블랙 모드: 고른 적이 있으면 그 값(localStorage), 없으면 기기 설정을 따른다. 화면을 그리기 전에 붙여야 번쩍임이 없다 --%>
<script>(function (d) { d.className += ' js'; try { var t = localStorage.getItem('tw-theme'); if (t === 'dark' || t === 'light') d.setAttribute('data-theme', t); } catch (e) {} })(document.documentElement);</script>
<c:if test="${needMap}"><script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" defer></script></c:if>
<script src="js/app.js?v=${applicationScope.assetV}" defer></script>
<script src="js/course.js?v=${applicationScope.assetV}" defer></script>
<c:if test="${needMap}"><script src="js/maps.js?v=${applicationScope.assetV}" defer></script></c:if>
<c:if test="${not empty pageJs}"><script src="js/${pageJs}.js?v=${applicationScope.assetV}" defer></script></c:if>
</head>
<body>

<%-- 아이콘 한 벌: 24 격자 · 선 1.5 · 둥근 끝 · currentColor. <svg class="ic"><use href="#i-이름"/></svg> 로 쓴다.
     날씨는 #w-이름 (sun · cloud-sun · cloud · overcast · rain · sleet · snow · shower) — 서버 · 지도 JSON 의 icon 값이 이 이름이다 --%>
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
	<symbol id="w-sun" viewBox="0 0 24 24"><g style="stroke: var(--wi-sun, currentColor)"><circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6L7 7M17 17l1.4 1.4M5.6 18.4L7 17M17 7l1.4-1.4"/></g></symbol>
	<symbol id="w-cloud-sun" viewBox="0 0 24 24"><g style="stroke: var(--wi-sun, currentColor)"><path d="M7.5 2.5v1.3M2.5 7.5h1.3M4 4l.9.9M11 4l-.9.9"/><path d="M7.4 11.2A3.4 3.4 0 117.5 4.3"/></g><g style="stroke: var(--wi-cloud, currentColor)"><path d="M9.5 20a3.5 3.5 0 01-.3-6.98 5 5 0 019.5 1.3A3 3 0 0118 20z"/></g></symbol>
	<symbol id="w-cloud" viewBox="0 0 24 24"><g style="stroke: var(--wi-cloud, currentColor)"><path d="M7 19a4 4 0 01-.6-7.95A6 6 0 0118 12a3.5 3.5 0 01-.5 7z"/></g></symbol>
	<symbol id="w-overcast" viewBox="0 0 24 24"><g style="stroke: var(--wi-cloud, currentColor)"><path d="M7.5 11.5A4.2 4.2 0 0115.7 9.6 3.4 3.4 0 0121 12.8"/><path d="M6.5 20a3.4 3.4 0 01-.3-6.8 5 5 0 019.5 1.2 2.8 2.8 0 01-.2 5.6z"/></g></symbol>
	<symbol id="w-rain" viewBox="0 0 24 24"><g style="stroke: var(--wi-cloud, currentColor)"><path d="M7 14a4 4 0 01-.6-7.95A6 6 0 0118 7a3.5 3.5 0 01-.5 7z"/></g><g style="stroke: var(--wi-rain, currentColor)"><path d="M8 17.5l-1 3M12 17.5l-1 3M16 17.5l-1 3"/></g></symbol>
	<symbol id="w-sleet" viewBox="0 0 24 24"><g style="stroke: var(--wi-cloud, currentColor)"><path d="M7 14a4 4 0 01-.6-7.95A6 6 0 0118 7a3.5 3.5 0 01-.5 7z"/></g><g style="stroke: var(--wi-rain, currentColor)"><path d="M8.5 17.5l-1 3"/></g><g style="stroke: var(--wi-snow, currentColor)"><path d="M16 17.5v3.6M14.2 18.6l3.6 1.8M17.8 18.6l-3.6 1.8"/></g></symbol>
	<symbol id="w-snow" viewBox="0 0 24 24"><g style="stroke: var(--wi-cloud, currentColor)"><path d="M7 14a4 4 0 01-.6-7.95A6 6 0 0118 7a3.5 3.5 0 01-.5 7z"/></g><g style="stroke: var(--wi-snow, currentColor)"><path d="M8 16.8v3.6M6.2 17.9l3.6 1.8M9.8 17.9l-3.6 1.8M16 16.8v3.6M14.2 17.9l3.6 1.8M17.8 17.9l-3.6 1.8"/></g></symbol>
	<symbol id="w-shower" viewBox="0 0 24 24"><g style="stroke: var(--wi-sun, currentColor)"><path d="M7.5 1.8v1.2M2 7.5h1.2M3.6 3.6l.8.8M11.4 3.6l-.8.8"/><path d="M7.2 10.6A3.2 3.2 0 117.4 4.4"/></g><g style="stroke: var(--wi-cloud, currentColor)"><path d="M9.5 15.5a3.5 3.5 0 01-.3-6.98 5 5 0 019.5 1.3A3 3 0 0118 15.5z"/></g><g style="stroke: var(--wi-rain, currentColor)"><path d="M11 18l-.8 2.6M15 18l-.8 2.6M19 18l-.8 2.6"/></g></symbol>

	<symbol id="i-tree" viewBox="0 0 24 24"><path d="M12 21v-6M12 15c-4 0-6.5-2.5-6.5-5.5C5.5 6 8.5 3 12 3s6.5 3 6.5 6.5C18.5 12.5 16 15 12 15z"/></symbol>
	<symbol id="i-museum" viewBox="0 0 24 24"><path d="M3 9l9-5 9 5M5.5 9v9M9.8 9v9M14.2 9v9M18.5 9v9M3 21h18M3 18h18"/></symbol>
	<symbol id="i-pin" viewBox="0 0 24 24"><path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0113 0c0 5-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.3"/></symbol>
	<symbol id="i-calendar" viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4"/></symbol>
	<symbol id="i-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></symbol>
	<symbol id="i-route" viewBox="0 0 24 24"><circle cx="6" cy="18" r="2.5"/><circle cx="18" cy="6" r="2.5"/><path d="M8.5 18H15a3 3 0 000-6H9a3 3 0 010-6h6.5"/></symbol>
	<symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
	<symbol id="i-check" viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7"/></symbol>
	<symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></symbol>
	<symbol id="i-up" viewBox="0 0 24 24"><path d="M12 19V5M6 11l6-6 6 6"/></symbol>
	<symbol id="i-down" viewBox="0 0 24 24"><path d="M12 5v14M6 13l6 6 6-6"/></symbol>
	<symbol id="i-chevron" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></symbol>
	<symbol id="i-x" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18"/></symbol>
	<symbol id="i-trash" viewBox="0 0 24 24"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13"/></symbol>
	<symbol id="i-warn" viewBox="0 0 24 24"><path d="M12 4l9.5 16h-19zM12 10v4M12 17v.5"/></symbol>
	<symbol id="i-info" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 7.5v.5"/></symbol>
	<symbol id="i-drop" viewBox="0 0 24 24"><path d="M12 3s6 6.5 6 11a6 6 0 01-12 0c0-4.5 6-11 6-11z"/></symbol>
	<symbol id="i-umbrella" viewBox="0 0 24 24"><path d="M3 12a9 9 0 0118 0zM12 12v6.5a2 2 0 004 0"/></symbol>
	<symbol id="i-mask" viewBox="0 0 24 24"><path d="M5 8.5c4.5-2 9.5-2 14 0v4.5c0 3-3 5-7 5s-7-2-7-5zM5 9.5H2.5M19 9.5h2.5M8.5 13h7M8.5 15h7"/></symbol>
	<symbol id="i-thermo" viewBox="0 0 24 24"><path d="M10 14.2V5a2 2 0 014 0v9.2a4 4 0 11-4 0zM12 9v7"/></symbol>
	<symbol id="i-shirt" viewBox="0 0 24 24"><path d="M8.5 4L3 7l2 4 2.5-1V20h9V10L19 11l2-4-5.5-3a3.5 3.5 0 01-7 0z"/></symbol>
	<symbol id="i-map" viewBox="0 0 24 24"><path d="M3 6l6-2 6 2 6-2v14l-6 2-6-2-6 2zM9 4v14M15 6v14"/></symbol>
	<symbol id="i-list" viewBox="0 0 24 24"><path d="M8.5 6.5H20M8.5 12H20M8.5 17.5H20M4 6.5h.01M4 12h.01M4 17.5h.01"/></symbol>
	<symbol id="i-locate" viewBox="0 0 24 24"><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="1.5"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/></symbol>
	<symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/></symbol>
	<symbol id="i-phone" viewBox="0 0 24 24"><path d="M6 3h3l1.5 4-2 1.5a11 11 0 006 6L16 12.5l4 1.5v3a2 2 0 01-2 2A15 15 0 014 5a2 2 0 012-2z"/></symbol>
	<symbol id="i-link" viewBox="0 0 24 24"><path d="M10 14a4 4 0 005.7 0l3-3a4 4 0 00-5.7-5.7l-1 1M14 10a4 4 0 00-5.7 0l-3 3a4 4 0 005.7 5.7l1-1"/></symbol>
	<symbol id="i-external" viewBox="0 0 24 24"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 01-1 1H5a1 1 0 01-1-1V7a1 1 0 011-1h5"/></symbol>
	<symbol id="i-share" viewBox="0 0 24 24"><circle cx="6" cy="12" r="2.5"/><circle cx="17.5" cy="6" r="2.5"/><circle cx="17.5" cy="18" r="2.5"/><path d="M8.2 10.8l7.1-3.6M8.2 13.2l7.1 3.6"/></symbol>
	<symbol id="i-moon" viewBox="0 0 24 24"><path d="M20 14.5A8 8 0 019.5 4a8 8 0 1010.5 10.5z"/></symbol>
	<symbol id="i-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6L7 7M17 17l1.4 1.4M5.6 18.4L7 17M17 7l1.4-1.4"/></symbol>
	<symbol id="i-sunrise" viewBox="0 0 24 24"><path d="M3 18h18M7 18a5 5 0 0110 0M12 6v3M5 10l1.5 1.5M19 10l-1.5 1.5M9 7l3-3 3 3"/></symbol>
	<symbol id="i-sunset" viewBox="0 0 24 24"><path d="M3 18h18M7 18a5 5 0 0110 0M12 6v3M5 10l1.5 1.5M19 10l-1.5 1.5M9 4l3 3 3-3"/></symbol>
	<symbol id="i-wind" viewBox="0 0 24 24"><path d="M3 9h10a3 3 0 10-3-3M3 14h14a3 3 0 11-3 3M3 19h6"/></symbol>
	<symbol id="i-users" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.5 2.7-6 6-6s6 2.5 6 6M16 5.2a3 3 0 010 5.6M18 14.4c1.8.8 3 2.6 3 5.6"/></symbol>
	<symbol id="i-cloud" viewBox="0 0 24 24"><path d="M7 18a4 4 0 01-.6-7.95A6 6 0 0118 11a3.5 3.5 0 01-.5 7z"/></symbol>
	<symbol id="i-play" viewBox="0 0 24 24"><path d="M8 5.5v13l10.5-6.5z"/></symbol>
	<symbol id="i-pause" viewBox="0 0 24 24"><path d="M8.5 5.5v13M15.5 5.5v13"/></symbol>
	<symbol id="i-print" viewBox="0 0 24 24"><path d="M7 9V4h10v5M7 17H4.5v-8h15v8H17M7 14h10v6H7z"/></symbol>
	<symbol id="i-image" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="10" r="1.6"/><path d="M4 18l5-5 4 4 3-3 4 4"/></symbol>
</svg>

<a class="skip" href="#main">본문으로 건너뛰기</a>
<div class="loadbar" id="loadbar" aria-hidden="true"></div>

<header class="top">
	<div class="wrap top-in">
		<a href="plan" class="brand">
			<svg class="logo" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0113 0c0 5-6.5 11-6.5 11z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="12" cy="10" r="2.6" fill="var(--coral)"/></svg>
			<span>여행 날씨</span>
		</a>
		<nav class="nav" aria-label="주 메뉴">
			<a href="plan" class="${navActive == 'plan' ? 'on' : ''}" ${navActive == 'plan' ? 'aria-current="page"' : ''}>플래너</a>
			<a href="explore" class="${navActive == 'explore' ? 'on' : ''}" ${navActive == 'explore' ? 'aria-current="page"' : ''}>지도</a>
			<a href="course" class="course-link ${navActive == 'course' ? 'on' : ''}" ${navActive == 'course' ? 'aria-current="page"' : ''}>내 코스 <span class="course-badge" data-course-count ${empty courseCount or courseCount == 0 ? 'data-zero' : ''}>${empty courseCount ? 0 : courseCount}</span></a>
		</nav>
		<button type="button" class="theme-btn js-only" data-theme-toggle aria-pressed="false" title="블랙 모드 켜기 · 끄기"><svg class="ic ic-moon" aria-hidden="true"><use href="#i-moon"/></svg><svg class="ic ic-sun" aria-hidden="true"><use href="#i-sun"/></svg><span class="sr-only">블랙 모드</span></button>
	</div>
</header>
