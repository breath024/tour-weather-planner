<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%-- 새 공공 API 자료 칸: 미세먼지(에어코리아) · 자외선(기상청 생활기상지수) · 해 뜨고 지는 시각(천문연) · 붐빔(관광공사 집중률).
     컨트롤러가 넣은 airView/airMissing, uvView/uvMissing, sun/sunError, crowdAvgText/crowdMissing 를 쓴다.
     자료가 없으면 칸이 회색이 되고 이유가 작게 나온다 --%>
<ul class="evid">
	<li class="ev ev-air ${empty airView ? 'none' : ''}">
		<svg class="ic ev-ic" aria-hidden="true"><use href="#i-wind"/></svg>
		<div class="ev-body">
			<b class="ev-k">미세먼지</b>
			<c:choose>
				<c:when test="${not empty airView}">
					<span class="ev-v gr-${airView.grade}">${fn:escapeXml(airView.gradeText)}</span>
					<small>PM10 ${fn:escapeXml(airView.pm10Text)} · PM2.5 ${fn:escapeXml(airView.pm25Text)}<br>${fn:escapeXml(airView.source)}<c:if test="${not empty airView.time}"> ${fn:escapeXml(airView.time)}</c:if><c:if test="${not empty airView.scope}"> · ${fn:escapeXml(airView.scope)}</c:if></small>
				</c:when>
				<c:otherwise><span class="ev-v">자료 없음</span><small><c:out value="${airMissing}"/></small></c:otherwise>
			</c:choose>
		</div>
	</li>
	<li class="ev ev-uv ${empty uvView ? 'none' : ''}">
		<svg class="ic ev-ic" aria-hidden="true"><use href="#i-sun"/></svg>
		<div class="ev-body">
			<b class="ev-k">자외선</b>
			<c:choose>
				<c:when test="${not empty uvView}">
					<span class="ev-v uv-${uvView.level}">${fn:escapeXml(uvView.levelText)} <span class="ev-n">지수 ${uvView.max}</span></span>
					<small><c:out value="${uvView.advice}"/></small>
				</c:when>
				<c:otherwise><span class="ev-v">자료 없음</span><small><c:out value="${uvMissing}"/></small></c:otherwise>
			</c:choose>
		</div>
	</li>
	<li class="ev ev-sun ${empty sun ? 'none' : ''}">
		<svg class="ic ev-ic" aria-hidden="true"><use href="#i-sunset"/></svg>
		<div class="ev-body">
			<b class="ev-k">일출 · 일몰</b>
			<c:choose>
				<c:when test="${not empty sun}">
					<span class="ev-v">${fn:escapeXml(sun.sunrise)} <span class="ev-n">일출</span> <span class="ev-arr" aria-hidden="true">·</span> ${fn:escapeXml(sun.sunset)} <span class="ev-n">일몰</span></span>
					<small>실외는 해 지기 전에 끝내요</small>
				</c:when>
				<c:otherwise><span class="ev-v">자료 없음</span><small><c:out value="${sunError}"/></small></c:otherwise>
			</c:choose>
		</div>
	</li>
	<c:if test="${empty hideCrowdLine}">
		<li class="ev ev-crowd ${empty crowdAvgText ? 'none' : ''}">
			<svg class="ic ev-ic" aria-hidden="true"><use href="#i-users"/></svg>
			<div class="ev-body">
				<b class="ev-k">붐빔</b>
				<c:choose>
					<c:when test="${not empty crowdAvgText}"><span class="ev-v"><c:out value="${crowdAvgText}"/></span><small>시·군·구 평균 · 관광공사 집중률 예측</small></c:when>
					<c:otherwise><span class="ev-v">자료 없음</span><small><c:out value="${crowdMissing}"/></small></c:otherwise>
				</c:choose>
			</div>
		</li>
	</c:if>
</ul>
