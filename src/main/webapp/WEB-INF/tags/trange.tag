<%@ tag pageEncoding="UTF-8" body-content="empty" trimDirectiveWhitespaces="true" %><%--
  최저 ~ 최고 기온 한 덩어리. 최저는 파랑 · 최고는 빨강 글자(숫자는 그대로 읽힌다).
  lo · hi(숫자) 또는 range(이미 만든 "-1° ~ 6°" 글자) 중 하나를 준다. 값이 없으면 "-" · merge="true" 면 두 값이 같을 때 하나만.
--%><%@ attribute name="lo" required="false" type="java.lang.Object" %><%@ attribute name="hi" required="false" type="java.lang.Object" %><%@ attribute name="range" required="false" type="java.lang.String" %><%@ attribute name="merge" required="false" type="java.lang.Boolean" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fn" uri="jakarta.tags.functions" %><c:choose><c:when test="${not empty range}"><c:set var="pp" value="${fn:split(range, '~')}"/><c:if test="${fn:length(pp) == 2}"><c:set var="l" value="${fn:trim(fn:replace(pp[0], '°', ''))}"/><c:set var="h" value="${fn:trim(fn:replace(pp[1], '°', ''))}"/></c:if></c:when><c:otherwise><c:set var="l" value="${lo}"/><c:set var="h" value="${hi}"/></c:otherwise></c:choose><c:choose><c:when test="${empty l or empty h}">${empty range ? '-' : fn:escapeXml(range)}</c:when><c:when test="${merge and l == h}"><span class="tr"><span class="t-one">${fn:escapeXml(h)}°</span></span></c:when><c:otherwise><span class="tr"><span class="t-lo">${fn:escapeXml(l)}°</span> ~ <span class="t-hi">${fn:escapeXml(h)}°</span></span></c:otherwise></c:choose>